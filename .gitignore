# secrets - never committed
.env

# dependencies - reinstallable from package.json
node_modules/

# build output - regenerated
dist/

# large generated research data (small samples are tracked; runs are not)
data/*.jsonl

# OS noise
.DS_Store
Thumbs.db

scratch/

# Scratch output from drills and experiments (never committed)
tmp/

# app/public/data/ (derived app data) is TRACKED since L065 so the deployed
# site has it. It holds the sample dataset only; it passed
# cli/validateAppData.js (no secrets, no private notes, byte-identical) and
# the one manual unit was read and contains nothing personal. Re-validate
# and re-decide before committing data from the real study.

# generated exports. Includes the L059 private human-scoring key files
# (export/human/human-key-*.json), which map blind refs to unit_ids and so
# to model ids: committing one would break the blinding of every human score.
export/

# L061 raw manual transcripts (unredacted model responses)
manual/*.txt